# Copy this to .env and fill it in. .env is gitignored; never commit a key.

# Which model, written as provider:model. The provider fills in the endpoint
# and the name of the key variable. Known providers:
#
#   nrp         https://ellm.nrp-nautilus.io/v1          NRP_API_KEY
#   openai      https://api.openai.com/v1                OPENAI_API_KEY
#   zai         https://api.z.ai/api/coding/paas/v4      ZAI_API_KEY
#   together    https://api.together.xyz/v1              TOGETHER_API_KEY
#   groq        https://api.groq.com/openai/v1           GROQ_API_KEY
#   openrouter  https://openrouter.ai/api/v1             OPENROUTER_API_KEY
#   ollama      http://localhost:11434/v1                OLLAMA_API_KEY
#
MODEL=openai:gpt-5.5

# The key itself, in whichever variable that provider expects.
OPENAI_API_KEY=

# For an endpoint not listed above, name all three yourself:
#
# MODEL=my-model
# MODEL_URL=https://your-endpoint/v1
# MODEL_API_KEY_ENV=MY_API_KEY
# MY_API_KEY=

# Any OpenAI-compatible endpoint works. The model needs tool calling and a
# context window large enough for a long investigation; a reasoning model is
# fine, and its thinking counts against the completion budget rather than
# being returned, which is why the app asks for a generous one.
